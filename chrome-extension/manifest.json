{
  "manifest_version": 3,
  "name": "AIBOX Chrome Session Connector",
  "description": "Lets AIBOX use your existing, signed-in Chrome tabs for AI provider sessions.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.deepseek.com/*",
    "https://chat.qwen.ai/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "http://127.0.0.1:3210/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AIBOX Chrome Session Connector"
  }
}
